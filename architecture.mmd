    subgraph AWS["AWS Cloud (ap-southeast-1)"]
        APIGW["API Gateway HTTP API\nPolicyAssistantApi\nStage: Prod"]
        Lambda["Lambda Function\nPolicyAssistantFunction\nPython 3.12 | 128 MB | 10 s"]
        DDB["DynamoDB Table\nPolicyAssistantPolicies\nPK: policy_id (String)\nOn-Demand Billing"]
        CWLogs["CloudWatch Logs\n/aws/lambda/PolicyAssistantFunction-...\nRetention: 30 days | JSON"]
        IAM["IAM Role\nPolicyAssistantFunctionRole\nLeast-Privilege Policy"]
    end

    Client -->|HTTPS GET| APIGW
    APIGW -->|Invoke AWS_PROXY| Lambda
    Lambda -->|GetItem / Scan| DDB
    Lambda -->|Logs JSON| CWLogs
    Lambda -.->|Assumes| IAM
    IAM -.->|Allows| DDB

